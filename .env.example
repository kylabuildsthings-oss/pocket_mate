# Environment template for PocketMate (fill values for your deployment)

# Etherscan API Key - https://docs.etherscan.io/getting-started/viewing-api-usage-statistics
ETHERSCAN_API_KEY="<API-key>"

# download OpenSSL to generate random key: `openssl rand -hex 32`
JWT_SECRET="<JWT Secret>"
# Legacy client-only paths — value is STILL exposed in the browser bundle; prefer server-only JWT verification for new code.
NEXT_PUBLIC_JWT_SECRET="<Next-Public-JWT-Secret>"

# https://www.rainbowkit.com/docs/installation
# WalletConnect Cloud (preferred). If unset, dev uses RainbowKit placeholder (console warning).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
NEXT_PUBLIC_RAINBOW_PROJECT_ID="<Rainbow-kit-project-ID>"

# https://docs.pinata.cloud/reference/datatestauthentication
PINATA_KEY="<Pinata Key>"
PINATA_SECRET_KEY="<Pinata-Secret-Key"

# https://docs.sendgrid.com/ui/account-and-settings/api-keys
SENDGRID_API_KEY="<Sengrid-API-Key>"
SENDGRID_TRANSPORTER_EMAIL_ADDRESS="<Sendgrid-Email-Address>"

# https://www.mongodb.com/basics/mongodb-connection-string
MONGODB_URI="<MondoDB-URI>"

# https://docs.alchemy.com/reference/ethereum-api-quickstart
NEXT_PUBLIC_ALCHEMY_GOERLI="API-Key"

# Local app URL (used by client-side service calls)
NEXT_PUBLIC_HOST="http://localhost:3010"

# --- PocketMate launch (Phase 14) ---
# Public support/contact (safe to expose)
NEXT_PUBLIC_SUPPORT_EMAIL=""
# Optional external status page (e.g. status.yourdomain.com)
NEXT_PUBLIC_STATUS_PAGE_URL=""
# Production canonical URL for OAuth callbacks and emails (e.g. https://pocketmate.example.com)
# NEXTAUTH_URL="https://your-production-host"
# Many hosts set VERCEL_URL automatically; prefer explicit NEXTAUTH_URL in production.

# --- PocketMate Phase 11 (Postgres + NextAuth wallet SIWE) ---
# Example: postgresql://postgres:postgres@localhost:5432/pocketmate?schema=public
DATABASE_URL=""
# openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3010"
# Comma-separated lowercase 0x addresses promoted to ADMIN on first wallet login
POCKETMATE_ADMIN_WALLETS=""