// PocketMate Phase 11 — Postgres data layer (optional until DATABASE_URL is set)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  walletAddress String?   @unique
  role          UserRole  @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile        Profile?
  learnProgress  LearnProgress[]
  badges         UserBadge[]
  strategies     SavedStrategy[]
  comments    CommunityComment[]
  auditEvents AuditEvent[]
}

model Profile {
  id          String  @id @default(cuid())
  userId      String  @unique
  displayName String?
  university  String?
  avatarUrl   String?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearnProgress {
  id            String    @id @default(cuid())
  userId        String
  lessonId      String
  completedAt   DateTime?
  quizAttempts  Int       @default(0)
  quizBestScore Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model SavedStrategy {
  id         String   @id @default(cuid())
  userId     String
  name       String
  templateId String
  notes      String?  @db.Text
  risk       String
  timeframe  String
  meta       Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommunityComment {
  id         String   @id @default(cuid())
  userId     String?
  strategyId String
  parentId   String?
  body       String   @db.Text
  score      Int      @default(0)
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([strategyId])
}

model AuthNonce {
  id        String   @id @default(cuid())
  address   String
  nonce     String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([address, consumed, expiresAt])
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  path      String?
  eventType String
  payload   Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([createdAt])
}
