{
  "name": "pocketmate",
  "private": true,
  "version": "1.0.0",
  "description": "Learn. Trade. Build. PocketMate — lessons, trade surfaces (demo/live), and strategy builder for DeFi practice.",
  "author": "Jason Schwarz <jason.c.schwarz@gmail.com> & Nathan Tarbert <nate4t@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/kylabuildsthings-oss/pocket_mate",
  "repository": {
    "type": "git",
    "url": "https://github.com/kylabuildsthings-oss/pocket_mate"
  },
  "engines": {
    "node": ">=18",
    "yarn": ">=1.22.10"
  },
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "verify:client-env": "node scripts/check-client-env.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "prepare": "husky install",
    "docker": "docker build -t pocketmate . && docker run -p 3000:3000 pocketmate",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.1.0",
    "@chakra-ui/next-js": "^2.1.5",
    "@chakra-ui/react": "^2.8.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@fontsource-variable/jetbrains-mono": "^5.0.8",
    "@fontsource/permanent-marker": "^5.0.7",
    "@fontsource/slackey": "^5.0.7",
    "@pinata/sdk": "^2.1.0",
    "@prisma/client": "^5.22.0",
    "@rainbow-me/rainbowkit": "^1.0.8",
    "@sendgrid/mail": "^7.7.0",
    "@tabler/icons-react": "^2.42.0",
    "@uniswap/widgets": "^2.59.0",
    "@vercel/kv": "^0.2.2",
    "autoprefixer": "^10.4.14",
    "axios": "^1.4.0",
    "canvas-confetti": "^1.9.4",
    "chai-as-promised": "^7.1.1",
    "dotenv": "^16.0.0",
    "ethers": "^6.8.1",
    "formidable": "2.1.1",
    "framer-motion": "^10.15.0",
    "fs": "^0.0.1-security",
    "graphql": "^16.7.1",
    "immer": "^10.0.2",
    "jsonwebtoken": "8.5.1",
    "mongodb": "^6.3.0",
    "mongoose": "^8.0.3",
    "next": "^13.4.19",
    "next-auth": "^4.24.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "react-redux": "^8.1.3",
    "usehooks-ts": "^2.9.1",
    "uuid": "^9.0.0",
    "viem": "0.3.35",
    "wagmi": "^1.4.12",
    "web3": "^4.2.2",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@svgr/webpack": "^6.2.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/formidable": "2.0.6",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/mocha": "^9.1.0",
    "@types/mongodb": "^4.0.7",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^20.4.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.7",
    "eslint": "8.8.0",
    "eslint-config-next": "^13.4.19",
    "eslint-config-prettier": "^8.3.0",
    "husky": "^7.0.4",
    "lint-staged": "^12.3.3",
    "node-mocks-http": "^1.16.1",
    "prettier": "^2.5.1",
    "prisma": "^5.22.0",
    "ts-node": "^10.4.0",
    "typechain": "^3.0.0",
    "typescript": "~5.4.5",
    "vite": "^5.4.11",
    "vitest": "^1.6.0"
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "*.{js,ts,tsx,css,md}": "prettier --write"
  }
}
